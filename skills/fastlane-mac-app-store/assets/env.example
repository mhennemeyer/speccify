# Copy to fastlane/.env and fill in. NEVER commit the real file.
#
#   cp fastlane/.env.example fastlane/.env
#   echo "fastlane/.env" >> .gitignore
#
# Create the key in App Store Connect -> Users and Access -> Integrations ->
# App Store Connect API. The "App Manager" role is sufficient; a build machine
# does not need Admin.
#
# The .p8 file can be downloaded EXACTLY ONCE. Store it outside the repository
# (a password manager or ~/.appstoreconnect/private_keys/) and reference it by
# path below. If it is lost, the key can only be revoked and replaced.

# Key ID, e.g. "ABCD1234EF"
ASC_KEY_ID=

# Issuer ID of your App Store Connect team (a UUID)
ASC_ISSUER_ID=

# Absolute path to the .p8 — outside this repository
ASC_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_ABCD1234EF.p8
