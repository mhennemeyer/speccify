{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speccify",
  "version": "0.5.0",
  "identifier": "io.speccify.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mhennemeyer/speccify/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "app": {
    "windows": [
      {
        "title": "Speccify",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/speccify-exec-mcp",
      "binaries/speccify-discovery-mcp",
      "binaries/speccify-parallels-mcp",
      "binaries/uv"
    ],
    "resources": [
      "resources/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
