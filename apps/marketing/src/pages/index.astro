---
// Landing page: hero, problem/solution, a real tool contract, how it works,
// the app, CTA. Header and footer live in MarketingLayout.
import MarketingLayout from "../layouts/MarketingLayout.astro";

const title = "Speccify — share the contract, not the implementation";
const description =
  "The agent-agnostic skill and tool manager: reusable skills shared over Git, tool contracts your agent implements and verifies per project, and a desktop app that runs the whole workflow — plans, tickets, board — on macOS and Windows.";

const problems = [
  "What you learned the hard way lives in one project. The next project starts from zero, and so does the agent.",
  "Ready-made scripts break on the next machine: a different Python, a different OS, a path that only existed on yours.",
  "Agent workflows drift — every project invents its own way to plan, slice work, and keep the human in the loop.",
];

const solutions = [
  "Skills are plain SKILL.md files, shared over Git like Go modules — no account, no registry. speccify expand copies them into the project where every agent finds them.",
  "Tools ship as contracts, not scripts: TOOL.md defines inputs, outputs, effects, and examples. Your agent implements it for this machine — speccify tool check proves it works.",
  "One file-based workflow — plans, tickets, questions, history — that any agent can follow and the Speccify app makes visible. Claude Code and Codex are equally at home.",
];

const useCases = [
  { name: "Platform rituals", note: "Notarization, entitlements, store review" },
  { name: "Payments & auth", note: "Trials, subscriptions, OAuth flows" },
  { name: "Team workflows", note: "Plans, tickets, review loops for agents" },
  { name: "Client projects", note: "Each with its own skill repo and sources" },
];

const steps = [
  {
    title: "1 · Expand",
    body: "speccify expand copies a skill and its tool contracts into .agent/ — normalized, versioned, provenance recorded. Every agent reads the same files.",
  },
  {
    title: "2 · Execute",
    body: "Your agent implements each tool contract for this machine and this platform. No fragile shared scripts — the contract travels, the implementation is local.",
  },
  {
    title: "3 · Evaluate",
    body: "speccify tool check runs the contract's examples against the implementation. Status becomes verified only when the examples pass — never by hand.",
  },
  {
    title: "4 · Work the board",
    body: "The app turns the active plan into tickets, the agent works them one at a time, asks when it must, and writes history you can audit.",
  },
];

const demo = `$ speccify expand macos-notarize-tauri --library ~/work/skills
✓ .agent/skills/macos-notarize-tauri/SKILL.md
✓ .agent/tools/verify-signatures/TOOL.md   (contract, no implementation yet)

# agent implements .agent/tools/verify-signatures/macos.sh …

$ speccify tool check verify-signatures
✓ example 1  clean bundle          → ok: true
✓ example 2  unsigned sidecar      → ok: false, names the offender
verified  verify-signatures (macos)`;

const contract = `# TOOL.md — the contract an agent implements per project
name: verify-signatures
description: Verifies the code signature of a macOS .app bundle and of
  every executable inside Contents/MacOS — the sidecars notarization
  rejects without the build ever saying so.
inputs:
  type: object
  required: [bundle]
effects: [reads-filesystem]
# examples below are the acceptance test for any implementation`;
---

<MarketingLayout title={title} description={description}>
  <main class="mx-auto max-w-5xl px-6">
    <!-- Hero -->
    <section class="flex flex-col items-center gap-6 py-20 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-400">
        The agent-agnostic skill &amp; tool manager
      </p>
      <h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">
        Share the contract, not the implementation.
      </h1>
      <p class="max-w-2xl text-lg text-slate-300">
        <strong class="text-slate-100">Skills</strong> carry what you learned —
        shared over Git, expanded into every project.
        <strong class="text-slate-100">Tool contracts</strong> say what a tool
        must do; your agent implements them for this machine and
        <code class="text-sky-300">speccify tool check</code> proves they work.
        And the <strong class="text-slate-100">Speccify app</strong> runs the
        whole workflow — plans, tickets, board, questions — on macOS and
        Windows, with Claude Code or Codex in the terminal.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/tutorial/intro/"
          class="rounded-md bg-sky-500 px-5 py-2.5 font-medium text-white transition hover:bg-sky-400"
        >
          Tutorial: zero to App Store
        </a>
        <a
          href="/download/"
          class="rounded-md border border-slate-700 px-5 py-2.5 font-medium text-slate-200 transition hover:border-slate-500"
        >
          Download the app
        </a>
        <a
          href="https://github.com/mhennemeyer/speccify"
          class="rounded-md border border-slate-700 px-5 py-2.5 font-medium text-slate-200 transition hover:border-slate-500"
        >
          GitHub
        </a>
      </div>
    </section>

    <!-- Problem / solution -->
    <section class="grid gap-8 py-12 md:grid-cols-2">
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
        <h2 class="mb-4 text-lg font-semibold text-rose-300">The problem</h2>
        <ul class="space-y-3 text-slate-300">
          {problems.map((item) => <li>· {item}</li>)}
        </ul>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
        <h2 class="mb-4 text-lg font-semibold text-emerald-300">The idea</h2>
        <ul class="space-y-3 text-slate-300">
          {solutions.map((item) => <li>· {item}</li>)}
        </ul>
      </div>
    </section>

    <!-- What a contract looks like -->
    <section class="py-12">
      <h2 class="mb-2 text-center text-2xl font-bold">
        What a tool contract looks like
      </h2>
      <p class="mx-auto mb-6 max-w-2xl text-center text-slate-400">
        From the notarization skill in this repository. The contract names
        inputs, outputs, effects — and its examples are the acceptance test for
        any implementation.
      </p>
      <pre class="overflow-x-auto rounded-xl border border-slate-800 bg-black/60 p-6 text-sm text-sky-200"><code>{contract}</code></pre>
    </section>

    <!-- Worth writing down -->
    <section class="py-12">
      <h2 class="mb-2 text-center text-2xl font-bold">Worth capturing</h2>
      <p class="mx-auto mb-6 max-w-2xl text-center text-slate-400">
        The test is not how big a task is. It is: <em class="text-slate-300"
          >would I have had to figure this out again in the next project?</em
        >
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          useCases.map((useCase) => (
            <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6 text-center">
              <p class="text-lg font-semibold text-emerald-300">{useCase.name}</p>
              <p class="mt-2 text-sm text-slate-400">{useCase.note}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Demo snippet -->
    <section class="py-12">
      <h2 class="mb-4 text-center text-2xl font-bold">
        Expand it, implement it, verify it
      </h2>
      <pre class="overflow-x-auto rounded-xl border border-slate-800 bg-black/60 p-6 text-sm text-emerald-200"><code>{demo}</code></pre>
    </section>

    <!-- How it works -->
    <section class="py-12">
      <h2 class="mb-6 text-center text-2xl font-bold">How it works</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step) => (
            <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
              <p class="text-sm font-semibold uppercase tracking-widest text-sky-400">
                {step.title}
              </p>
              <p class="mt-3 text-slate-300">{step.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- The app -->
    <section class="flex flex-col items-center gap-5 py-16 text-center">
      <h2 class="text-2xl font-bold">One window per project, an agent inside</h2>
      <p class="max-w-xl text-slate-300">
        The Speccify app opens every project in its own window, laid out like
        Xcode: files with a code editor and Git, the board with your tickets,
        plans, skills and tool contracts with their verification status,
        project actions with live output — and an agent terminal that already
        knows the project and picks its session back up after a restart. The
        app watches files; the agent does the work. Everything it shows is plain files in
        <code class="text-sky-300">.agent/</code>, so it works with any agent
        and survives without the app.
      </p>
      <a
        href="/app/overview/"
        class="rounded-md bg-sky-500 px-6 py-3 font-medium text-white transition hover:bg-sky-400"
      >
        Tour the app
      </a>
    </section>
  </main>
</MarketingLayout>
