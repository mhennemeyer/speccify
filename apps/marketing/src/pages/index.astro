---
// Full Tailwind landing page (Stage 4): hero, problem/solution, demo snippet,
// targets, "how it works", CTA. Footer + header live in MarketingLayout.
import MarketingLayout from "../layouts/MarketingLayout.astro";

const title = "Speccify — npm für Spezifikationen statt für Code";
const description =
  "Beschreibe, was Software tun soll — nicht wie. Der AI-Agent ist der Compiler in dein Ziel-Framework, deine Sprache, dein Stack.";

const problems = [
  "Dasselbe Verhalten wird pro Sprache und Framework von Hand neu gebaut — Implementierungen driften auseinander.",
  "Verhalten und Akzeptanzkriterien leben verstreut in Tickets, Code und Köpfen.",
  "Updates müssen in jedem Ziel-Repo einzeln nachgezogen werden.",
];

const solutions = [
  "Eine versionierte speccify.yaml ist die Single Source of Truth — für UI-Komponenten, reine Funktionen, Domain-Logik, Workflows bis hin zu ganzen Anwendungen.",
  "Der AI-Agent rendert daraus deterministisch Code — reproduzierbar via Lockfile.",
  "Conformance- und Visual-Regression-Checks sichern jedes Ziel ab.",
];

const useCases = [
  { name: "UI-Komponenten", note: "Buttons, Formulare, ganze Screens" },
  { name: "Reine Funktionen", note: "Validierung, Parsing, Transformationen" },
  { name: "Domain-Logik", note: "Geschäftsregeln, Berechnungen, Policies" },
  { name: "Workflows & Apps", note: "Mehrschrittige Prozesse bis zur ganzen Anwendung" },
];

const targets = [
  { name: "React", note: "TypeScript + tsc-Build-Smoke" },
  { name: "SwiftUI", note: "swiftc -typecheck" },
  { name: "Angular", note: "Standalone Components" },
];

const steps = [
  {
    title: "1 · Spec",
    body: "Beschreibe Inputs/Outputs, Verhalten und Akzeptanzkriterien in speccify.yaml.",
  },
  {
    title: "2 · Resolver",
    body: "MVS löst Dependencies auf und pinnt sie reproduzierbar in speccify.lock.",
  },
  {
    title: "3 · Codegen",
    body: "Der Agent generiert Code für dein Ziel — ob UI, Funktion, Domain-Logik oder Workflow.",
  },
];

const demo = `$ speccify pull spec://button@1.0.0 --target react
✓ resolved button@1.0.0
✓ rendered  speccify_generated/react/Button.tsx
✓ verified  output hash matches speccify.lock`;
---

<MarketingLayout title={title} description={description}>
  <main class="mx-auto max-w-5xl px-6">
    <!-- Hero -->
    <section class="flex flex-col items-center gap-6 py-20 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-400">
        Spec-First Platform für jede Software
      </p>
      <h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">
        npm für Spezifikationen statt für Code
      </h1>
      <p class="max-w-2xl text-lg text-slate-300">
        Eine <code class="rounded bg-slate-800 px-1.5 py-0.5">speccify.yaml</code>
        beschreibt einmal, <em>was</em> etwas tun soll — von einer UI-Komponente über
        reine Funktionen und Domain-Logik bis hin zu Workflows und ganzen
        Anwendungen. Speccify kompiliert sie deterministisch in dein Ziel — heute
        React, SwiftUI und Angular, morgen weitere Sprachen und Frameworks.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/getting-started/installation/"
          class="rounded-md bg-sky-500 px-5 py-2.5 font-medium text-white transition hover:bg-sky-400"
        >
          Quickstart
        </a>
        <a
          href="https://github.com/speccify/speccify"
          class="rounded-md border border-slate-700 px-5 py-2.5 font-medium text-slate-200 transition hover:border-slate-500"
        >
          GitHub
        </a>
      </div>
    </section>

    <!-- Problem / Lösung -->
    <section class="grid gap-8 py-12 md:grid-cols-2">
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
        <h2 class="mb-4 text-lg font-semibold text-rose-300">Das Problem</h2>
        <ul class="space-y-3 text-slate-300">
          {problems.map((item) => <li>· {item}</li>)}
        </ul>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
        <h2 class="mb-4 text-lg font-semibold text-emerald-300">Die Lösung</h2>
        <ul class="space-y-3 text-slate-300">
          {solutions.map((item) => <li>· {item}</li>)}
        </ul>
      </div>
    </section>

    <!-- Demo snippet -->
    <section class="py-12">
      <h2 class="mb-4 text-center text-2xl font-bold">Ein Befehl, ein Target</h2>
      <pre class="overflow-x-auto rounded-xl border border-slate-800 bg-black/60 p-6 text-sm text-emerald-200"><code>{demo}</code></pre>
    </section>

    <!-- Was du spezifizieren kannst -->
    <section class="py-12">
      <h2 class="mb-2 text-center text-2xl font-bold">Was du spezifizieren kannst</h2>
      <p class="mx-auto mb-6 max-w-2xl text-center text-slate-400">
        Speccify ist sprach- und framework-unabhängig. Eine Spec beschreibt
        Verhalten — nicht nur Optik.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          useCases.map((useCase) => (
            <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6 text-center">
              <p class="text-lg font-semibold text-emerald-300">{useCase.name}</p>
              <p class="mt-2 text-sm text-slate-400">{useCase.note}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Targets -->
    <section class="py-12">
      <h2 class="mb-2 text-center text-2xl font-bold">Aktuelle Targets</h2>
      <p class="mx-auto mb-6 max-w-2xl text-center text-slate-400">
        Diese Ziele werden heute deterministisch generiert — die Architektur ist
        bewusst offen für weitere Sprachen und Frameworks.
      </p>
      <div class="grid gap-4 sm:grid-cols-3">
        {
          targets.map((target) => (
            <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6 text-center">
              <p class="text-lg font-semibold text-sky-300">{target.name}</p>
              <p class="mt-2 text-sm text-slate-400">{target.note}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- How it works -->
    <section class="py-12">
      <h2 class="mb-6 text-center text-2xl font-bold">How it works</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {
          steps.map((step) => (
            <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
              <p class="text-sm font-semibold uppercase tracking-widest text-sky-400">
                {step.title}
              </p>
              <p class="mt-3 text-slate-300">{step.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section class="flex flex-col items-center gap-5 py-16 text-center">
      <h2 class="text-2xl font-bold">Probier es im Browser</h2>
      <p class="max-w-xl text-slate-300">
        Der Live-Playground rendert die Referenz-Specs offline gegen React,
        SwiftUI und Angular — ohne Setup.
      </p>
      <a
        href="/try-it/"
        class="rounded-md bg-sky-500 px-6 py-3 font-medium text-white transition hover:bg-sky-400"
      >
        Zum Playground
      </a>
    </section>
  </main>
</MarketingLayout>
