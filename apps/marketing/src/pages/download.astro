---
// Download page for the desktop app.
//
// The download always points at the latest GitHub release, so this page never
// needs redeploying when a release ships. What it must be honest about is the
// Gatekeeper warning: the build is not signed with an Apple Developer ID yet,
// and a download page that hides that produces "the app is damaged" reports.
import MarketingLayout from "../layouts/MarketingLayout.astro";

const title = "Download Speccify";
const description =
  "The Speccify desktop app for macOS and Windows: board, plans, skills, tool contracts, project actions and an agent terminal — one window per project.";

const repo = "https://github.com/mhennemeyer/speccify";
// Resolves to the newest published release; no rebuild of this page needed.
const downloadUrl = `${repo}/releases/latest`;
// Set once a Developer ID certificate is in the repository secrets.
const isSigned = import.meta.env.PUBLIC_RELEASE_SIGNED === "true";

const features = [
  {
    name: "Specs, board, history",
    body: "One folder per piece of work, tasks as checkboxes, Backlog → Doing as your gate, an auditable history per spec — per project, or across the repositories of a workspace on one shared board.",
  },
  {
    name: "Skills & tool contracts",
    body: "Expanded skills with provenance, tool contracts with per-platform verification status, and a source browser that imports via speccify expand.",
  },
  {
    name: "Project actions",
    body: "Named commands from .agent/actions.json, run natively with live output, progress and charts — agent proposals approved with one click.",
  },
  {
    name: "Agent terminal",
    body: "A real PTY in the project directory. Claude Code and Codex are equal presets; questions the agent leaves in specs surface as notifications.",
  },
];
---

<MarketingLayout title={title} description={description}>
  <main class="mx-auto max-w-5xl px-6 py-12">
    <section class="flex flex-col items-center gap-5 py-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-400">
        Desktop app for macOS, Windows and Linux
      </p>
      <h1 class="max-w-3xl text-4xl font-bold tracking-tight">
        Speccify on your machine
      </h1>
      <p class="max-w-2xl text-lg text-slate-300">
        Viewer, MCP servers and agent terminal in one app. No repository, no
        Rust, no Python setup — it brings everything it needs.
      </p>

      <div class="flex flex-col items-center gap-3">
        <a
          href={downloadUrl}
          class="rounded-md bg-sky-500 px-6 py-3 text-lg font-medium text-white transition hover:bg-sky-400"
        >
          Download the latest release
        </a>
        <p class="text-sm text-slate-400">
          macOS: Apple Silicon, macOS 11+ (<code>.dmg</code>) · Windows: x64
          (<code>*-setup.exe</code>) · Linux: x86_64 (<code>.AppImage</code>,
          <code>.deb</code>, <code>.rpm</code>){isSigned ? " · signed and notarized" : ""}
        </p>
      </div>

      {/* Direct links per platform, filled from the GitHub releases API at
          page load — asset names carry the version, so there is no stable
          URL to hard-code; this way the links are current the moment a
          release is published, without rebuilding the site. */}
      <div
        id="direct-downloads"
        class="w-full rounded-xl border border-slate-800 bg-slate-900/50 p-6 text-left"
        data-repo="mhennemeyer/speccify"
      >
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p class="text-lg font-semibold text-slate-200">Direct downloads</p>
          <p class="text-sm text-slate-400" data-role="version">Looking up the latest release…</p>
        </div>
        <ul class="mt-4 grid gap-3 md:grid-cols-3">
          <li class="rounded-lg border border-slate-800 p-4" data-platform="mac">
            <p class="font-medium text-slate-200">macOS <span class="text-sm font-normal text-slate-400">Apple Silicon</span></p>
            <ul class="mt-2 space-y-1 text-sm" data-role="links"></ul>
          </li>
          <li class="rounded-lg border border-slate-800 p-4" data-platform="windows">
            <p class="font-medium text-slate-200">Windows <span class="text-sm font-normal text-slate-400">x64</span></p>
            <ul class="mt-2 space-y-1 text-sm" data-role="links"></ul>
          </li>
          <li class="rounded-lg border border-slate-800 p-4" data-platform="linux">
            <p class="font-medium text-slate-200">Linux <span class="text-sm font-normal text-slate-400">x86_64</span></p>
            <ul class="mt-2 space-y-1 text-sm" data-role="links"></ul>
          </li>
        </ul>
        <noscript>
          <p class="mt-3 text-sm text-slate-400">
            Direct links need JavaScript — use the release page above instead.
          </p>
        </noscript>
      </div>

      <script>
        // Kinds per platform, matched against asset file names.
        const KINDS = [
          { platform: "mac", label: ".dmg", test: (n: string) => /\.dmg$/.test(n) },
          { platform: "windows", label: "Installer (.exe)", test: (n: string) => /-setup\.exe$/.test(n) },
          { platform: "windows", label: "MSI", test: (n: string) => /\.msi$/.test(n) },
          { platform: "linux", label: "AppImage", test: (n: string) => /\.AppImage$/.test(n) },
          { platform: "linux", label: ".deb", test: (n: string) => /\.deb$/.test(n) },
          { platform: "linux", label: ".rpm", test: (n: string) => /\.rpm$/.test(n) },
        ];
        const root = document.getElementById("direct-downloads");
        const repo = root?.dataset.repo;
        const size = (bytes: number) =>
          bytes >= 1e6 ? `${(bytes / 1e6).toFixed(0)} MB` : `${Math.round(bytes / 1e3)} kB`;
        const ua = navigator.userAgent;
        const here = /Windows/.test(ua) ? "windows" : /Mac/.test(ua) ? "mac" : /Linux/.test(ua) ? "linux" : "";

        async function fill() {
          if (!root || !repo) return;
          const version = root.querySelector('[data-role="version"]') as HTMLElement | null;
          try {
            const response = await fetch(`https://api.github.com/repos/${repo}/releases/latest`, {
              headers: { Accept: "application/vnd.github+json" },
            });
            if (!response.ok) throw new Error(`GitHub API ${response.status}`);
            const release = await response.json();
            const assets: Array<{ name: string; size: number; browser_download_url: string }> =
              release.assets ?? [];
            if (version) {
              version.textContent = `${release.tag_name} · ${new Date(release.published_at).toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" })}`;
            }
            for (const item of root.querySelectorAll<HTMLElement>("[data-platform]")) {
              const platform = item.dataset.platform ?? "";
              const list = item.querySelector('[data-role="links"]');
              if (!list) continue;
              let any = false;
              for (const kind of KINDS.filter((k) => k.platform === platform)) {
                const asset = assets.find((a) => kind.test(a.name));
                if (!asset) continue;
                any = true;
                const li = document.createElement("li");
                const a = document.createElement("a");
                a.href = asset.browser_download_url;
                a.className = "text-sky-400 hover:text-sky-300";
                a.textContent = kind.label;
                const meta = document.createElement("span");
                meta.className = "text-slate-500";
                meta.textContent = ` · ${size(asset.size)}`;
                li.append(a, meta);
                list.append(li);
              }
              if (!any) {
                const li = document.createElement("li");
                li.className = "text-slate-500";
                li.textContent = "not in this release";
                list.append(li);
              }
              if (platform === here) {
                item.classList.add("border-sky-500/60");
                const tag = document.createElement("span");
                tag.className = "ml-2 rounded-full bg-sky-500/20 px-2 py-0.5 text-xs text-sky-300";
                tag.textContent = "your platform";
                item.querySelector("p")?.append(tag);
              }
            }
          } catch (error) {
            if (version) version.textContent = "Could not reach GitHub — use the release page above.";
            console.warn("direct downloads", error);
          }
        }
        void fill();
      </script>

      {
        !isSigned && (
          <div class="w-full rounded-xl border border-amber-500/40 bg-amber-500/5 p-6 text-left">
            <p class="text-lg font-semibold text-amber-200">
              Gatekeeper will complain on first launch
            </p>
            <p class="mt-2 text-slate-300">
              The build is not signed with an Apple Developer ID yet, so macOS
              refuses it the first time — usually with “Speccify is damaged and
              can’t be opened”, which is misleading: nothing is damaged, it is
              simply unsigned. Open it once via right-click → Open, or lift the
              quarantine flag:
            </p>
            <pre class="mt-4 overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-4 text-sm text-slate-200"><code>xattr -dr com.apple.quarantine /Applications/Speccify.app</code></pre>
            <p class="mt-4 text-sm text-slate-400">
              Only do that for software you trust. If you would rather not,
              build it yourself — the instructions are below, and the result is
              identical because the release is built from this repository by a
              public workflow.
            </p>
          </div>
        )
      }

      {
        !isSigned && (
          <div class="w-full rounded-xl border border-amber-500/40 bg-amber-500/5 p-6 text-left">
            <p class="text-lg font-semibold text-amber-200">
              Windows: SmartScreen warns on first launch
            </p>
            <p class="mt-2 text-slate-300">
              The installer is not code-signed yet, so SmartScreen shows
              "Windows protected your PC" the first time. Click
              <strong> More info → Run anyway</strong> — or build it yourself
              below; the release is produced from this repository by a public
              workflow, so the result is identical.
            </p>
          </div>
        )
      }

      <div class="w-full rounded-xl border border-slate-800 bg-slate-900/50 p-6 text-left">
        <p class="text-lg font-semibold text-slate-200">Linux</p>
        <p class="mt-2 text-slate-300">
          Three formats, pick one. The <strong>AppImage</strong> runs on any
          distribution without installing: download it, mark it executable
          (right-click → Properties → “Allow executing”, or
          <code class="rounded bg-slate-800 px-1.5 py-0.5">chmod +x Speccify_*.AppImage</code>),
          double-click. The <strong>.deb</strong> (Ubuntu, Debian, Mint) and
          <strong>.rpm</strong> (Fedora, openSUSE) install through your package
          manager and put Speccify in the application menu. There is no
          Gatekeeper or SmartScreen equivalent on Linux — nothing to click
          through.
        </p>
        <p class="mt-4 text-slate-300">
          <strong>What it needs:</strong> a desktop session with
          <strong>WebKitGTK 4.1</strong> (<code class="rounded bg-slate-800 px-1.5 py-0.5">libwebkit2gtk-4.1</code>),
          which is how the app draws its window. Ubuntu 22.04 and newer,
          Debian 12, Fedora 37 and newer, and current openSUSE, Arch and Mint
          ship it; the .deb and .rpm pull it in as a dependency. For the
          Git and agent features, <code class="rounded bg-slate-800 px-1.5 py-0.5">git</code> and
          Claude Code or Codex on your PATH, as on any platform.
        </p>
        <p class="mt-4 text-slate-300"><strong>Where it will not work, or needs a hand:</strong></p>
        <ul class="mt-2 list-disc space-y-1.5 pl-5 text-slate-300">
          <li>
            <strong>Older distributions</strong> (Ubuntu 20.04, Debian 11 and
            earlier) only have WebKitGTK 4.0 — the app will not start there.
          </li>
          <li>
            <strong>AppImage without FUSE 2:</strong> Ubuntu 22.04 and newer
            no longer install <code class="rounded bg-slate-800 px-1.5 py-0.5">libfuse2</code> by
            default, and the AppImage needs it to mount itself. Either
            <code class="rounded bg-slate-800 px-1.5 py-0.5">sudo apt install libfuse2</code>, run it
            with <code class="rounded bg-slate-800 px-1.5 py-0.5">--appimage-extract-and-run</code>, or use the
            .deb instead.
          </li>
          <li>
            <strong>KDE Plasma</strong> works — WebKitGTK is a library, not a
            desktop requirement — but the window uses GTK styling, so it will
            not follow your Qt theme, and the .deb/.rpm bring GTK and WebKitGTK
            along if they are missing.
          </li>
          <li>
            <strong>Wayland with NVIDIA drivers:</strong> if the window comes
            up blank or flickers, start it with
            <code class="rounded bg-slate-800 px-1.5 py-0.5">WEBKIT_DISABLE_DMABUF_RENDERER=1</code>
            (or <code class="rounded bg-slate-800 px-1.5 py-0.5">WEBKIT_DISABLE_COMPOSITING_MODE=1</code>) — a known
            WebKitGTK issue, not specific to Speccify.
          </li>
          <li>
            <strong>Headless servers, containers, WSL without WSLg:</strong> no
            display, no window. WSL2 with WSLg works.
          </li>
          <li>
            <strong>ARM (Raspberry Pi, ARM laptops), Alpine/musl:</strong> not
            built — the release is x86_64 glibc only. Build from source there
            (below).
          </li>
        </ul>
      </div>

      <div class="w-full rounded-xl border border-slate-800 bg-slate-900/50 p-6 text-left">
        <p class="text-lg font-semibold text-slate-200">Or build it yourself</p>
        <p class="mt-2 text-slate-400">
          Two steps — the script fetches dependencies, builds the app and starts
          it:
        </p>
        <pre class="mt-4 overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-4 text-sm text-slate-200"><code># macOS
git clone https://github.com/mhennemeyer/speccify
cd speccify && ./scripts/dev.sh --release

# Windows (PowerShell)
git clone https://github.com/mhennemeyer/speccify
cd speccify; powershell -ExecutionPolicy Bypass -File scripts\dev.ps1

# Linux (Debian/Ubuntu package names; Fedora: webkit2gtk4.1-devel etc.)
sudo apt install libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libssl-dev patchelf build-essential
git clone https://github.com/mhennemeyer/speccify
cd speccify && ./scripts/dev.sh --release</code></pre>
        <p class="mt-4 text-sm text-slate-400">
          Prerequisites:
          <code class="rounded bg-slate-800 px-1.5 py-0.5">uv</code>,
          <code class="rounded bg-slate-800 px-1.5 py-0.5">pnpm</code> and
          <code class="rounded bg-slate-800 px-1.5 py-0.5">cargo</code> — the
          script checks for them and names the install command if one is
          missing.
        </p>
      </div>
    </section>

    <section class="grid gap-6 py-8 md:grid-cols-2">
      {
        features.map((feature) => (
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
            <h2 class="mb-2 text-lg font-semibold text-slate-100">
              {feature.name}
            </h2>
            <p class="text-slate-300">{feature.body}</p>
          </div>
        ))
      }
    </section>

    <section class="py-8">
      <h2 class="mb-4 text-2xl font-bold">On first launch</h2>
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
        <p class="text-slate-300">
          The app ships its Python engine as a payload and builds an
          environment from it on first launch — one click in the Environment tab
          ("Install engine"). That needs an internet connection <strong>once</strong>;
          everything after that runs offline. None of it lands in your projects
          or in a system Python installation.
        </p>
        <p class="mt-4 text-slate-400">
          Intel Macs are not covered yet — the macOS build targets Apple
          Silicon.
        </p>
      </div>
    </section>

    <section class="flex flex-col items-center gap-4 py-10 text-center">
      <h2 class="text-xl font-bold">Rather stay in the terminal?</h2>
      <p class="max-w-xl text-slate-300">
        Everything the app does is also a CLI command and an MCP tool. The
        quickstart takes you through both.
      </p>
      <a
        href="/tutorial/prerequisites/"
        class="rounded-md border border-slate-700 px-5 py-2.5 font-medium text-slate-200 transition hover:border-slate-500"
      >
        Quickstart
      </a>
    </section>
  </main>
</MarketingLayout>
