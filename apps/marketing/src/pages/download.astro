---
// Download page for the desktop app. While no signed release exists,
// PUBLIC_DOWNLOAD_URL is empty and the page shows the self-build route instead
// of a dead link.
import MarketingLayout from "../layouts/MarketingLayout.astro";

const title = "Download Speccify for macOS";
const description =
  "The Speccify desktop app: playbook viewer, MCP servers and agent terminal in one signed app — no repository, no toolchain.";

const downloadUrl = import.meta.env.PUBLIC_DOWNLOAD_URL ?? "";
const version = import.meta.env.PUBLIC_DOWNLOAD_VERSION ?? "";
const hasRelease = Boolean(downloadUrl);

const features = [
  {
    name: "Playbook viewer",
    body: "The workflow as a diagram, steps as rendered markdown, every source with its age.",
  },
  {
    name: "MCP servers included",
    body: "Exec, Discovery, Parallels and the playbook engine ship with the app — your coding agents find them through a ready-made .mcp.json.",
  },
  {
    name: "Agent terminal",
    body: "A real PTY in your working directory. The agent reads what you select in the viewer, so questions resolve against what is on screen.",
  },
  {
    name: "Questions in the UI",
    body: "Agents ask real questions through ask_bo — buttons, multi-select and forms instead of guessing.",
  },
];
---

<MarketingLayout title={title} description={description}>
  <main class="mx-auto max-w-5xl px-6 py-12">
    <section class="flex flex-col items-center gap-5 py-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-sky-400">
        Desktop app for macOS
      </p>
      <h1 class="max-w-3xl text-4xl font-bold tracking-tight">
        Speccify on your machine
      </h1>
      <p class="max-w-2xl text-lg text-slate-300">
        Viewer, MCP servers and agent terminal in one app. No repository, no
        Rust, no Python setup — it brings everything it needs.
      </p>

      {
        hasRelease ? (
          <div class="flex flex-col items-center gap-3">
            <a
              href={downloadUrl}
              class="rounded-md bg-sky-500 px-6 py-3 text-lg font-medium text-white transition hover:bg-sky-400"
            >
              Download Speccify {version} (.dmg)
            </a>
            <p class="text-sm text-slate-400">
              Apple Silicon · macOS 11 or newer · signed and notarized
            </p>
          </div>
        ) : (
          <div class="w-full rounded-xl border border-slate-800 bg-slate-900/50 p-8 text-left">
            <p class="text-lg font-semibold text-slate-200">
              No public build yet
            </p>
            <p class="mt-2 text-slate-400">
              The app is finished; the signed release is still pending. Until
              then you build it yourself in two steps — the script fetches
              dependencies, builds the app and starts it:
            </p>
            <pre class="mt-4 overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-4 text-sm text-slate-200"><code>git clone https://github.com/speccify/speccify
cd speccify && ./scripts/dev.sh --release</code></pre>
            <p class="mt-4 text-sm text-slate-400">
              Prerequisites for building it yourself:
              <code class="rounded bg-slate-800 px-1.5 py-0.5">uv</code>,
              <code class="rounded bg-slate-800 px-1.5 py-0.5">pnpm</code> and
              <code class="rounded bg-slate-800 px-1.5 py-0.5">cargo</code> —
              the script checks for them and names the install command if one
              is missing.
            </p>
          </div>
        )
      }
    </section>

    <section class="grid gap-6 py-8 md:grid-cols-2">
      {
        features.map((feature) => (
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
            <h2 class="mb-2 text-lg font-semibold text-slate-100">
              {feature.name}
            </h2>
            <p class="text-slate-300">{feature.body}</p>
          </div>
        ))
      }
    </section>

    <section class="py-8">
      <h2 class="mb-4 text-2xl font-bold">On first launch</h2>
      <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
        <p class="text-slate-300">
          The app ships its Python engine as a payload and builds an
          environment from it on first launch — one click in the Environment tab
          ("Install engine"). That needs an internet connection <strong>once</strong>;
          everything after that runs offline. None of it lands in your projects
          or in a system Python installation.
        </p>
        <p class="mt-4 text-slate-400">
          Windows and Intel Macs are not covered yet — the app is currently
          built for Apple Silicon.
        </p>
      </div>
    </section>

    <section class="flex flex-col items-center gap-4 py-10 text-center">
      <h2 class="text-xl font-bold">Rather stay in the terminal?</h2>
      <p class="max-w-xl text-slate-300">
        Everything the app does is also a CLI command and an MCP tool. The
        quickstart takes you through both.
      </p>
      <a
        href="/getting-started/installation/"
        class="rounded-md border border-slate-700 px-5 py-2.5 font-medium text-slate-200 transition hover:border-slate-500"
      >
        Quickstart
      </a>
    </section>
  </main>
</MarketingLayout>
