---
// Legal placeholder (Stage 4). Final text is supplied by the maintainer before
// the public launch (Phase 6 Stage-0 decision OQ8).
import MarketingLayout from "../../layouts/MarketingLayout.astro";

const title = "Imprint — Speccify";
const description = "Imprint / legal notice placeholder.";
---

<MarketingLayout title={title} description={description}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="mb-6 text-3xl font-bold tracking-tight">Imprint</h1>
    <p class="text-slate-300">
      Platzhalter. Der finale Impressumstext wird vor dem Public-Launch ergänzt.
    </p>
  </main>
</MarketingLayout>
