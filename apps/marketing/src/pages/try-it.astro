---
// Playground embed (Stage 5): loads the live playground in an iframe. If
// PUBLIC_PLAYGROUND_URL is unset (local dev / downtime), a fallback block with a
// cross-link is shown instead of a blank iframe.
import MarketingLayout from "../layouts/MarketingLayout.astro";

const title = "Try Speccify — Live Playground";
const description =
  "Rendere die Referenz-Specs offline gegen React, SwiftUI und Angular im Browser.";

const playgroundUrl = import.meta.env.PUBLIC_PLAYGROUND_URL ?? "";
const hasPlayground = Boolean(playgroundUrl);
---

<MarketingLayout title={title} description={description}>
  <main class="mx-auto max-w-5xl px-6 py-12">
    <h1 class="mb-4 text-3xl font-bold tracking-tight">Live Playground</h1>
    <p class="mb-8 max-w-2xl text-slate-300">
      Der Playground lädt die fünf Referenz-Specs und rendert sie offline gegen
      React, SwiftUI und Angular — kein Live-LLM nötig.
    </p>

    {
      hasPlayground ? (
        <iframe
          src={playgroundUrl}
          title="Speccify Playground"
          loading="lazy"
          class="h-[70vh] w-full rounded-xl border border-slate-800 bg-slate-900"
        />
      ) : (
        <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-8 text-center">
          <p class="text-lg font-semibold text-slate-200">
            Playground gerade nicht eingebettet
          </p>
          <p class="mx-auto mt-2 max-w-xl text-slate-400">
            Es ist keine Playground-URL konfiguriert (oder die Instanz ist
            offline). Du kannst den Playground lokal starten oder das Repo auf
            GitHub ansehen.
          </p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
            <a
              href="https://github.com/speccify/speccify"
              class="rounded-md bg-sky-500 px-5 py-2.5 font-medium text-white transition hover:bg-sky-400"
            >
              GitHub-Repo
            </a>
            <a
              href="/getting-started/installation/"
              class="rounded-md border border-slate-700 px-5 py-2.5 font-medium text-slate-200 transition hover:border-slate-500"
            >
              Lokal starten
            </a>
          </div>
        </div>
      )
    }
  </main>
</MarketingLayout>
