{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speccify.io/schema/spec/v1.json",
  "title": "Speccify Spec v1",
  "description": "Schema v1 für speccify.yaml-Specs (OSS-Pivot P2). Ersetzt das unversionierte v0 ohne Migrationspfad (Entscheidung: Start bei Null, 2026-07-23). Kern-Neuerungen: formaler `api:`-Block (Props/Events/Slots/Fixtures — separat hashbar, Grundlage für deterministische Mocks) und `composition:` (Komponenten aus Unterkomponenten mit typgeprüfter Verdrahtung). Der Key `behavior:` ist für eine spätere optionale State-Machine reserviert (Entscheidung D2) und wird in v1 nicht validiert.",
  "type": "object",
  "required": ["schema_version", "id", "version", "kind", "title", "summary"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Spec-Schema-Version. v1 ist die erste explizit versionierte Fassung."
    },
    "id": {
      "type": "string",
      "description": "Spec-Identität. Form: spec://<name> oder @scope/<name>, optional mit @<semver>-Suffix.",
      "pattern": "^(spec://[a-z0-9][a-z0-9-]*|@[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*)(@[0-9A-Za-z.\\-+]+)?$"
    },
    "version": {
      "type": "string",
      "description": "SemVer 2.0.0.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "kind": {
      "type": "string",
      "description": "Komponentenklasse. `app` ist für Projekt-Specs (Phase P4) reserviert.",
      "enum": ["ui-component", "screen", "logic", "workflow", "app"]
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "license": { "type": "string", "minLength": 1 },
    "api": {
      "type": "object",
      "description": "Formaler API-Vertrag der Komponente. Grundlage für deterministische Mocks und die API-Conformance-Prüfung. Separat hashbar — API-Breaking-Changes erzwingen einen Major-Bump.",
      "additionalProperties": false,
      "properties": {
        "props": {
          "type": "array",
          "items": { "$ref": "#/$defs/prop" }
        },
        "outputs": {
          "type": "array",
          "description": "Benannte Rückgabewerte (v. a. logic/screen-Kinds).",
          "items": { "$ref": "#/$defs/output" }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        },
        "slots": {
          "type": "array",
          "description": "Benannte Einhängepunkte für Kind-Inhalte (UI-Kinds).",
          "items": { "$ref": "#/$defs/slot" }
        },
        "fixtures": {
          "type": "array",
          "description": "Deklarierte Beispiel-/Mock-Daten (Entscheidung D1: logic-Kinds werden fixture-basiert gemockt).",
          "items": { "$ref": "#/$defs/fixture" }
        }
      }
    },
    "composition": {
      "type": "object",
      "description": "Komposition aus Unterkomponenten. Verdrahtung wird gegen die `api:`-Blöcke der Kinder typgeprüft (CompositionValidator in core).",
      "required": ["uses", "tree"],
      "additionalProperties": false,
      "properties": {
        "uses": {
          "type": "object",
          "description": "Alias → Spec-Referenz (mit optionalem Versions-Range-Suffix). Aliase sind die Knoten-Namen in `tree`/`wiring`.",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(spec://[a-z0-9][a-z0-9-]*|@[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*)(@[\\^~]?[0-9A-Za-z.\\-+*x]+)?$"
          }
        },
        "tree": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/treeNode" }
        },
        "wiring": {
          "type": "array",
          "items": { "$ref": "#/$defs/wiringRule" }
        }
      }
    },
    "app": {
      "type": "object",
      "description": "Projekt-Belange einer `kind: app`-Spec (Phase P4): Routen auf die Top-Level-Knoten der Komposition, Theme-Tokens und Env-Variablen. Nur für `kind: app` zulässig.",
      "required": ["routes"],
      "additionalProperties": false,
      "properties": {
        "routes": {
          "type": "array",
          "minItems": 1,
          "description": "Routen-Tabelle; die erste Route ist die Startroute.",
          "items": { "$ref": "#/$defs/route" }
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokens": {
              "type": "object",
              "description": "Design-Tokens; werden als CSS-Custom-Properties (--<name>) ausgegeben.",
              "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        },
        "env": {
          "type": "array",
          "description": "Konfigurationswerte des Projekts (Build-Zeit, `import.meta.env`).",
          "items": { "$ref": "#/$defs/envVar" }
        }
      }
    },
    "uses": {
      "type": "array",
      "description": "Lose referenzierte Specs (ohne Kompositions-Semantik). `composition.uses` zählt zusätzlich automatisch als Dependency.",
      "items": {
        "type": "string",
        "pattern": "^(spec://[a-z0-9][a-z0-9-]*|@[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*)(@[\\^~]?[0-9A-Za-z.\\-+*x]+)?$"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "anyOf": [{ "required": ["then"] }, { "required": ["when"] }],
        "properties": {
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      }
    },
    "ux": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "references": {
          "type": "array",
          "description": "Asset-Referenzen: relative Pfade, asset://, figma://, http(s)://.",
          "items": {
            "type": "string",
            "pattern": "^(\\.{1,2}/.+|[a-zA-Z][a-zA-Z0-9+.\\-]*://.+)$"
          }
        },
        "a11y": { "type": "string" },
        "i18n": { "type": "string" }
      }
    },
    "screenshots": {
      "type": "array",
      "description": "Visual-Regression-Referenzen (Phase 5c/5d; `tolerance` aus Phase-7-S4 via Entscheidung D4).",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "tolerance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Pixel-Diff-Toleranz 0..1; überschreibt den 10%-Default."
          }
        }
      }
    },
    "non_functional": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "performance": { "type": "string" },
        "security": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fixtures": { "type": "string" },
        "golden_renders": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "typeString": {
      "type": "string",
      "minLength": 1,
      "description": "Typ-Ausdruck. Kanonisch: string | integer | number | boolean | enum[a, b] | object{...} | array[...] | map[k,v]. Unbekannte Ausdrücke sind erlaubt (Mocks behandeln sie als opaque)."
    },
    "prop": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": { "$ref": "#/$defs/typeString" },
        "required": { "type": "boolean", "default": false },
        "default": {},
        "description": { "type": "string" },
        "constraints": {
          "type": "array",
          "description": "Freie Constraint-Hints (email, url, min=100 …) — nicht mock-relevant, aber prompt-relevant.",
          "items": { "type": "string", "minLength": 1 }
        },
        "map_to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
          "description": "Explizites Prop-Forwarding an ein Kompositions-Kind: '<alias>.<prop>' (Entscheidung D3: kein automatisches Durchreichen)."
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": { "$ref": "#/$defs/typeString" },
        "description": { "type": "string" }
      }
    },
    "event": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "payload": {
          "type": "object",
          "description": "Feldname → Typ-Ausdruck. Fehlendes/leeres payload == Event ohne Daten.",
          "additionalProperties": { "$ref": "#/$defs/typeString" }
        },
        "description": { "type": "string" }
      }
    },
    "slot": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "optional": { "type": "boolean", "default": true },
        "description": { "type": "string" }
      }
    },
    "fixture": {
      "type": "object",
      "required": ["name", "data"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "data": {},
        "description": { "type": "string" }
      }
    },
    "treeNode": {
      "type": "object",
      "required": ["node"],
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Alias aus `composition.uses`."
        },
        "props": {
          "type": "object",
          "description": "Statische Prop-Belegung; wird gegen die Kind-API typgeprüft.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "slots": {
          "type": "object",
          "description": "Slot-Name → Liste von Kind-Knoten.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/treeNode" }
          }
        }
      }
    },
    "wiringSource": {
      "description": "Wert-Quelle einer Verdrahtung: 'payload.<field>' (Payload des auslösenden Events), 'props.<alias>.<prop>' (aktueller Prop-Wert eines Kindes) oder ein Literal.",
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "wiringRule": {
      "type": "object",
      "required": ["when"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["emit"] },
        { "required": ["set", "to"] },
        { "required": ["navigate"] }
      ],
      "properties": {
        "when": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
          "description": "Auslöser: '<alias>.<event>'."
        },
        "navigate": {
          "$ref": "#/$defs/routePath",
          "description": "Nur `kind: app` (Phase P4): wechselt auf die Route mit diesem Pfad."
        },
        "emit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Eigenes Event aus `api.events`, das re-emittiert wird."
        },
        "with": {
          "type": "object",
          "description": "Payload-Mapping für `emit`: Feldname → wiringSource.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/wiringSource" }
        },
        "set": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
          "description": "Ziel-Prop eines Kindes: '<alias>.<prop>'."
        },
        "to": { "$ref": "#/$defs/wiringSource" }
      }
    },
    "routePath": {
      "type": "string",
      "pattern": "^/[a-z0-9\\-/]*$",
      "description": "Route-Pfad, immer mit '/' beginnend (keine Parameter im P4-Schnitt)."
    },
    "route": {
      "type": "object",
      "required": ["path", "node"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/routePath" },
        "node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Top-Level-Alias aus `composition.tree`, der diese Route rendert."
        },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "envVar": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "default": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
