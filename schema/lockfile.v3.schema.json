{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speccify.io/schema/lockfile/v3.json",
  "title": "Speccify Lockfile v3",
  "description": "Schema v3 für speccify.lock — Phase-3-Multi-Target. Bump gegenüber v2: Top-Level `target: str` → `targets: list[str]` (Cross-Product über alle gelockten Targets); jeder LockEntry hat weiterhin ein eigenes `target`-Feld (welches der Targets aus der Top-Level-Liste). v1- und v2-Lockfiles bleiben lesbar (Loader-seitige Migration: single-target → single-element targets-list). Diese Datei ist Phase-3-Stage-1b-Vorgriff: derzeit nicht vom Loader geladen — `lockfile.schema.json` bleibt bis Code-Migration v2. Wird in Phase-3-Stage-1b-Code-Migration aktiv (Kopie nach `lockfile.schema.json`).",
  "type": "object",
  "required": ["schema_version", "targets", "specs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "targets": {
      "type": "array",
      "description": "Codegen-Ziele dieses Lockfiles. Mindestens ein Eintrag; alphabetisch sortiert, deduplizierte Liste.",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "signature": {
      "description": "Reservierter Slot für Spec-Bundle-Signaturen (sigstore ab Phase 4+). Default: `{kind: \"none\"}`.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "none" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "certificate", "rekor_log_index"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "sigstore" },
            "certificate": { "type": "string", "minLength": 1 },
            "rekor_log_index": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "specs": {
      "type": "array",
      "description": "Aufgelöste Specs, alphabetisch sortiert nach (id, target).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "sha256",
          "resolved_via",
          "target",
          "generator",
          "generated_files_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(spec://[a-z0-9][a-z0-9-]*|@[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*)$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "resolved_via": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Welches Target dieser Entry adressiert (eines der Top-Level-`targets`)."
          },
          "yank_status": {
            "type": "string",
            "enum": ["none", "yanked"],
            "description": "Yank-Status zum Zeitpunkt des letzten `lock`-Aufrufs. Default `none`; bei `yanked` warnt `speccify verify`."
          },
          "yank_reason": {
            "type": "string",
            "minLength": 1,
            "description": "Optionaler Yank-Grund, gespiegelt vom Registry."
          },
          "generator": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "template_set", "template_version"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "type": "string", "const": "template" },
                  "template_set": { "type": "string", "minLength": 1 },
                  "template_version": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
                  }
                }
              },
              {
                "type": "object",
                "required": ["kind", "provider", "model", "prompt_version", "cache_key"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "type": "string", "const": "llm" },
                  "provider": { "type": "string", "minLength": 1 },
                  "model": { "type": "string", "minLength": 1 },
                  "prompt_version": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
                  },
                  "seed": { "type": "integer", "minimum": 0 },
                  "cache_key": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            ]
          },
          "generated_files_sha256": {
            "type": "array",
            "description": "Output-Datei-Hashes nach `pull`. Nach reinem `lock` ist die Liste leer.",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
