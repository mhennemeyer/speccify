{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speccify.io/schema/lockfile/v2.json",
  "title": "Speccify Lockfile v2",
  "description": "Schema v2 für speccify.lock — deterministisches Auflösungs- und Output-Hash-Manifest. Bump gegenüber v1: optionales Top-Level-`signature` (Phase-2-Slot für sigstore, Default `kind: none`) und pro `LockEntry` optionales `yank_status` (`none|yanked`) + `yank_reason`. Phase-1-Lockfiles (`schema_version: 1`) bleiben lesbar (Loader-seitige Migration), neu geschriebene Lockfiles sind immer v2. Der `generator`-Pin ist eine Union: `kind: template` (template_set + template_version, Phase 1a) oder `kind: llm` (provider, model, prompt_version, optional seed, cache_key; ab Phase 1b für React-Codegen).",
  "type": "object",
  "required": ["schema_version", "target", "specs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Codegen-Ziel, gespiegelt aus dem Manifest zum Zeitpunkt des `lock`-Aufrufs."
    },
    "signature": {
      "description": "Reservierter Slot für Spec-Bundle-Signaturen (sigstore ab Phase 3+). Default in Phase 2: `{kind: \"none\"}`.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "none" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "certificate", "rekor_log_index"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "sigstore" },
            "certificate": { "type": "string", "minLength": 1 },
            "rekor_log_index": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "specs": {
      "type": "array",
      "description": "Aufgelöste Specs, alphabetisch nach `id` sortiert.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "sha256",
          "resolved_via",
          "target",
          "generator",
          "generated_files_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(spec://[a-z0-9][a-z0-9-]*|@[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*)$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "resolved_via": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "yank_status": {
            "type": "string",
            "enum": ["none", "yanked"],
            "description": "Yank-Status zum Zeitpunkt des letzten `lock`-Aufrufs. Default `none`; bei `yanked` warnt `speccify verify`."
          },
          "yank_reason": {
            "type": "string",
            "minLength": 1,
            "description": "Optionaler Yank-Grund, gespiegelt vom Registry."
          },
          "generator": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "template_set", "template_version"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "type": "string", "const": "template" },
                  "template_set": { "type": "string", "minLength": 1 },
                  "template_version": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
                  }
                }
              },
              {
                "type": "object",
                "required": ["kind", "provider", "model", "prompt_version", "cache_key"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "type": "string", "const": "llm" },
                  "provider": { "type": "string", "minLength": 1 },
                  "model": { "type": "string", "minLength": 1 },
                  "prompt_version": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
                  },
                  "seed": { "type": "integer", "minimum": 0 },
                  "cache_key": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            ]
          },
          "generated_files_sha256": {
            "type": "array",
            "description": "Output-Datei-Hashes nach `pull`. Nach reinem `lock` ist die Liste leer.",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
