// SwiftPM wiring for a vendored, statically linked libgit2.
//
// Absolute paths are derived from #filePath so nothing depends on the
// working directory, on pkg-config, or on Homebrew being installed.

import PackageDescription
import Foundation

let packageDir = URL(fileURLWithPath: #filePath).deletingLastPathComponent().path
let libgit2LibDir = "\(packageDir)/Vendor/libgit2/lib"

// ... inside targets: [ ... ]

// Carries the headers. Needs at least one source file, hence the empty shim.c.
// publicHeadersPath propagates the include path to every dependent target,
// under `swift build` and under Xcode alike.
.target(
    name: "Clibgit2",
    path: "Vendor/libgit2",
    exclude: ["lib", "README.md"],
    sources: ["shim.c"],
    publicHeadersPath: "include"
),

.target(
    name: "InProcessGit",
    dependencies: ["Clibgit2"],
    linkerSettings: [
        // -force_load, NOT -lgit2.
        //
        // libgit2's HTTPS transport registers itself; no symbol in your code
        // references it, so a plain -lgit2 lets the linker dead-strip it. The
        // app then builds, runs, does local Git fine, and fails on the first
        // push with an error that looks like TLS or credentials.
        //
        // Cost: .unsafeFlags makes this package unusable as a versioned
        // dependency of another package. Fine for a local package inside the
        // app repo; fatal if you intended to publish it.
        .unsafeFlags(["-Xlinker", "-force_load",
                      "-Xlinker", "\(libgit2LibDir)/libgit2.a"]),
        .linkedLibrary("z"),
        .linkedLibrary("iconv"),
        // SecureTransport lives in Security; CoreFoundation is its companion.
        .linkedFramework("Security"),
        .linkedFramework("CoreFoundation"),
    ]
),
