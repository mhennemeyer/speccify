<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ================================================================
         Shared iCloud container. These three keys are IDENTICAL in the
         macOS and the iOS target — one container, two apps. The id is not
         derived from the bundle id and each app does not get its own.

         They are a request, not a grant: until the container exists in the
         portal AND both app ids carry the iCloud capability pointing at it,
         the container resolves to nil at runtime, silently.
         ================================================================ -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.example.myapp</string>
    </array>
    <key>com.apple.developer.ubiquity-container-identifiers</key>
    <array>
        <string>iCloud.com.example.myapp</string>
    </array>
    <!-- Documents in iCloud Drive. CloudKit is a different product with a
         different API — choosing it here means a different storage layer. -->
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudDocuments</string>
    </array>

    <!-- ================================================================
         macOS target only, below. iCloud does not replace the sandbox.
         ================================================================ -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- The user picks a folder (NSOpenPanel). -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- App-scoped bookmarks, so that access survives a relaunch and the
         user does not re-pick the folder every launch. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
