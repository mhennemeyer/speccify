{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speccify.io/schema/lockfile/v1.json",
  "title": "Speccify Lockfile v1",
  "description": "Pins the exact playbooks a project resolved to. Version 1 is a clean restart alongside the playbook schema: no code generation, so no generator pins and no output hashes — what matters is which bundle, from where, at which commit.",
  "type": "object",
  "required": ["schema_version", "playbooks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "playbooks": {
      "type": "array",
      "description": "Resolved playbooks, sorted by id.",
      "items": {
        "type": "object",
        "required": ["id", "version", "resolved_via", "bundle_sha256"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(@[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*|git\\+[^\\s#]+(#[^\\s#]+)?)$",
            "description": "Local id or git source."
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "resolved_via": { "type": "string", "minLength": 1 },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Git sources only: the commit behind the tag."
          },
          "bundle_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Hash over the whole bundle (sorted paths plus contents), so assets are pinned too."
          }
        }
      }
    }
  }
}
